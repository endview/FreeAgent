      "properties": {
        "kind": {
          "enum": [
            "WorkspaceDefinition",
            "AssemblyProfile",
            "OperatorRequest",
            "TrustedClassifier",
            "LegacyTaskScope",
            "LegacyProfileSnapshot"
          ]
        },
