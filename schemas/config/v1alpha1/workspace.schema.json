        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/weightedHint"
          }
        }
      }
    },
    "agentBindingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denied_modules",
        "denied_skills",
        "denied_mcp_servers",
        "knowledge_mode",
        "knowledge_collections",
        "tools",
        "authority",
        "policy_hash"
      ],
      "properties": {
        "denied_modules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/moduleRef"
          }
        },
        "denied_skills": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/skillRef"
          }
        },
        "denied_mcp_servers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/mcpServerRef"
          }
        },
        "knowledge_mode": {
          "$ref": "#/$defs/policyMode"
        },
        "knowledge_collections": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/knowledgeCollectionID"
          }
        },
        "tools": {
          "$ref": "#/$defs/toolCapabilityPolicy"
        },
        "authority": {
          "$ref": "#/$defs/authorityPolicy"
        },
        "policy_hash": {
          "const": ""
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge_mode": {
                "const": "INHERIT"
              }
            },
            "required": [
              "knowledge_mode"
            ]
          },
          "then": {
            "properties": {
              "knowledge_collections": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "moduleSelection": {
      "description": "Selects one provider for a capability without owning its concrete attachment configuration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "failure_policy"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/dottedIdentifier"
