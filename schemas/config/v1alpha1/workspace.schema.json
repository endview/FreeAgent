        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/taskEvidenceInput"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "NEW"
            },
            "source": {
              "const": "WORKSPACE_DEFAULT"
            },
            "inputs": {
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/taskEvidenceInput"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "WorkspaceDefinition",
                          "AssemblyProfile"
                        ]
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "WorkspaceDefinition"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "AssemblyProfile"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "NEW"
            },
            "source": {
              "const": "OPERATOR_REQUEST"
            },
            "inputs": {
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/taskEvidenceInput"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "WorkspaceDefinition",
                          "AssemblyProfile",
                          "OperatorRequest"
                        ]
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "WorkspaceDefinition"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "AssemblyProfile"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "OperatorRequest"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "NEW"
            },
            "source": {
              "const": "TRUSTED_CLASSIFIER"
            },
            "inputs": {
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/taskEvidenceInput"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "WorkspaceDefinition",
                          "AssemblyProfile",
                          "TrustedClassifier"
                        ]
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "WorkspaceDefinition"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "AssemblyProfile"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "TrustedClassifier"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        },
        {
          "properties": {
            "mode": {
              "const": "LEGACY_BACKFILL"
