                        ]
                      }
                    }
                  }
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "LegacyTaskScope"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "LegacyProfileSnapshot"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            }
          }
        }
      ]
    }
