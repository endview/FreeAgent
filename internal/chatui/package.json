{
  "name": "freeagent-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "vite build && node scripts/check-frontend-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-frontend.mjs",
    "format": "prettier --write frontend vite.config.ts tsconfig.json components.json",
    "dev": "vite build --mode development --watch",
    "build:dev": "vite build --mode development",
    "ui:add": "pnpm dlx shadcn@4.23.0 add"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.11.1",
    "katex": "0.19.0",
    "lucide": "0.577.0",
    "lucide-react": "1.69.0",
    "markdown-it": "14.1.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.65.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
